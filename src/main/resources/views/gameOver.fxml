<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="750.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.GameOverController">

    <children>

        <!-- BACKGROUND -->
        <ImageView fitHeight="750.0" fitWidth="1000.0" pickOnBounds="true" preserveRatio="false">

            <image>
                <Image url="@../assets/backgrounds/pond.png" />
            </image>

        </ImageView>


        <!-- GAME OVER CONTENT -->
        <VBox alignment="CENTER" spacing="18.0">

            <!-- GAME RESULT TITLE -->
            <ImageView fx:id="resultImage" fitWidth="600.0" pickOnBounds="true" preserveRatio="true">
            </ImageView>


            <!-- TOTAL SCORE PANEL -->
            <StackPane alignment="CENTER" prefHeight="160.0" prefWidth="600.0">

                <ImageView fitWidth="600.0" pickOnBounds="true" preserveRatio="true">

                    <image>
                        <Image url="@../assets/others/score_back.png" />
                    </image>

                </ImageView>

                <Label fx:id="totalScoreLabel" styleClass="score-label" text="0 / 300"
                    translateY="12.0" />

            </StackPane>


            <!-- BACK TO MAIN MENU -->
            <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleMainMenu"
                styleClass="image-button">

                <graphic>

                    <ImageView fitWidth="320.0" pickOnBounds="true" preserveRatio="true">

                        <image>
                            <Image url="@../assets/others/backtomenu_button.png" />
                        </image>

                    </ImageView>

                </graphic>

            </Button>

        </VBox>

    </children>
    <stylesheets>
        <URL value="@../css/gameover.css" />
        <URL value="@../css/common.css" />
    </stylesheets>

</StackPane>