<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="750.0" prefWidth="1000.0" stylesheets="@../css/menu.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MenuController">

   <children>

      <!-- =========================================
             BACKGROUND
             ========================================= -->

      <ImageView fitHeight="750.0" fitWidth="1000.0" pickOnBounds="true" preserveRatio="false">

         <image>
            <Image url="@../assets/backgrounds/forest.png" />
         </image>

      </ImageView>


      <!-- =========================================
             MENU
             ========================================= -->

      <VBox alignment="CENTER" spacing="5.0">


         <!-- =====================================
                 TITLE
                 ===================================== -->

         <ImageView fitWidth="500.0" pickOnBounds="true" preserveRatio="true">

            <image>
               <Image url="@../assets/others/title.png" />
            </image>

         </ImageView>


         <!-- =====================================
                 BUTTONS
                 ===================================== -->

         <VBox alignment="CENTER" spacing="15.0">


            <!-- START GAME -->

            <Button fx:id="startButton" mnemonicParsing="false" onAction="#handleStartGame" styleClass="image-button">

               <graphic>

                  <ImageView fitWidth="320.0" pickOnBounds="true" preserveRatio="true">

                     <image>
                        <Image url="@../assets/others/start_button.png" />
                     </image>

                  </ImageView>

               </graphic>

            </Button>


            <!-- HOW TO PLAY -->

            <Button fx:id="howToButton" mnemonicParsing="false" onAction="#handleHowTo" styleClass="image-button">

               <graphic>

                  <ImageView fitWidth="320.0" pickOnBounds="true" preserveRatio="true">

                     <image>
                        <Image url="@../assets/others/howto_button.png" />
                     </image>

                  </ImageView>

               </graphic>

            </Button>


            <!-- EXIT GAME -->

            <Button fx:id="exitButton" mnemonicParsing="false" onAction="#handleExit" styleClass="image-button">

               <graphic>

                  <ImageView fitWidth="320.0" pickOnBounds="true" preserveRatio="true">

                     <image>
                        <Image url="@../assets/others/exit_button.png" />
                     </image>

                  </ImageView>

               </graphic>

            </Button>


         </VBox>

      </VBox>

   </children>

</StackPane>
