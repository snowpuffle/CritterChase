<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="750.0" prefWidth="1000.0" stylesheets="@../css/howto.css"
   xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="controllers.HowToController">

   <children>

      <!-- BACKGROUND -->
      <ImageView fitHeight="750.0" fitWidth="1000.0" pickOnBounds="true" preserveRatio="false">

         <image>
            <Image url="@../assets/backgrounds/pond.png" />
         </image>

      </ImageView>


      <!-- HOW TO PLAY -->
      <VBox alignment="CENTER" spacing="10.0">

         <!-- TITLE -->
         <ImageView fitWidth="500.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../assets/others/howto_title.png" />
            </image>
         </ImageView>


         <!-- INSTRUCTIONS -->
         <ImageView fitWidth="500.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../assets/others/howto_instructions.png" />
            </image>
         </ImageView>


         <!-- BACK TO MAIN MENU -->

         <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack"
            styleClass="image-button">

            <graphic>

               <ImageView fitWidth="350.0" pickOnBounds="true" preserveRatio="true">

                  <image>
                     <Image url="@../assets/others/backtomenu_button.png" />
                  </image>

               </ImageView>

            </graphic>

         </Button>

      </VBox>

   </children>

</StackPane>