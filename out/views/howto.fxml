               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Label text="Avoid the enemy animals chasing you!">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Label text="Collect all the food to win the level.">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
